---
import { withBase } from "../utils/paths";

interface Link {
  label: string;
  href: string;
}

interface Props {
  id: string;
  index: number;
  title: string;
  description: string;
  year: number;
  image?: string;
  imageAlt?: string;
  tags?: string[];
  links?: Link[];
}

const {
  id,
  index,
  title,
  description,
  year,
  image,
  imageAlt = "",
  tags = [],
  links = [],
} = Astro.props;

const projectUrl = withBase(`/projects/${id}/`);
const projectImage = withBase(
  image ?? "/images/project-placeholder.png"
);
---

<article class="project-row reveal">
  <div class="project-index">{String(index).padStart(2, "0")}</div>

  <a
    class="project-image-link"
    href={projectUrl}
    aria-label={`Read about ${title}`}
  >
    <div class="project-image-wrap">
      <img
        src={projectImage}
        alt={imageAlt}
        class="project-image"
        loading="lazy"
      />
    </div>
  </a>

  <div class="project-copy">
    <div class="project-meta">{year}</div>

    <h2>
      <a href={projectUrl}>{title}</a>
    </h2>

    <p>{description}</p>

    {tags.length > 0 && (
      <div class="tags" aria-label="Project topics">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}

    <div class="project-links">
      <a href={projectUrl}>
        Project page <span>→</span>
      </a>

      {links.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">
          {link.label} <span>↗</span>
        </a>
      ))}
    </div>
  </div>
</article>