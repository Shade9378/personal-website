---
import { withBase } from "../utils/paths";

interface Link {
  label: string;
  href: string;
}

interface Props {
  id: string;
  index: number;
  title: string;
  description: string;
  year?: number | string;
  image?: string;
  imageAlt?: string;
  screenshot?: boolean;
  tags?: string[];
  links?: Link[];
}

const {
  id,
  index,
  title,
  description,
  year,
  image,
  imageAlt = "",
  screenshot = false,
  tags = [],
  links = [],
} = Astro.props;

const projectUrl = withBase(`/projects/${id}/`);
const projectImage = image ? withBase(image) : undefined;
---

<article
  class="project-row reveal"
  data-project
  data-search={[id, title, description, ...tags].join(" ").toLowerCase()}
  data-tags={JSON.stringify(tags)}
>
  <div class="project-index">{String(index).padStart(2, "0")}</div>

  {projectImage && <a
    class="project-image-link"
    href={projectUrl}
    aria-label={`Read about ${title}`}
  >
    <div class:list={["project-image-wrap", { "project-screenshot": screenshot }]}>
      <img
        src={projectImage}
        alt={imageAlt}
        class="project-image"
        loading="lazy"
      />
    </div>
  </a>}

  <div class:list={["project-copy", { "project-copy--text-only": !projectImage }]}>
    {year && <div class="project-meta">{year}</div>}

    <h3>
      <a href={projectUrl}>{title}</a>
    </h3>

    <p>{description}</p>

    {tags.length > 0 && (
      <div class="tags" aria-label="Project topics">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}

    <div class="project-links">
      <a href={projectUrl}>
        Project page <span>→</span>
      </a>

      {links.filter((link) => link.href).map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer">
          {link.label} <span>↗</span>
        </a>
      ))}
    </div>
  </div>
</article>