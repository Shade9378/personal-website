---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
import updates from "../data/updates.json";
import publications from "../data/publications.json";
import { withBase } from "../utils/paths";

const MAX_UPDATES = 9;

// Keep updates.json ordered newest -> oldest.
const visibleUpdates = updates.slice(0, MAX_UPDATES).map((update) => ({
  ...update,
  parts: update.message.split(/("[^"]+")/).map((text) => {
    const publication = publications.find((entry) => entry.id && text === `"${entry.title}"`);
    return { text, href: publication ? withBase(`/publications/#${publication.id}`) : undefined };
  }),
}));
---

<BaseLayout title="Anh Vu">
  <section class="about-home">
    <div class="about-home-photo">
      <img
        src={withBase("/images/avatar.jpg")}
        alt="Cat wearing a DePauw cap with an explosion in the background"
      />
    </div>

    <div class="about-home-copy">
      <p class="eyebrow">About</p>

      <p>
        Hello! I’m Anh Vu (he/him), a senior at DePauw University, majoring in Computer Science, with
        minors in Psychology and Mathematics.
      </p>

      <p>
        My research interests are in developing systems and infrastructure to
        support education in underserved communities. I am interested in
        investigating how to effectively design and deploy such systems
        considering the computational resources
        available in these communities, as well as how students and teachers
        interact with these technologies and how they affect teaching and
        learning outcomes in both the short and long term.
      </p>

      <p>
        Recently, I have also become interested in data-driven intelligent systems that can provide personalized support for students and teachers in both classroom and self-directed learning settings.
      </p>

      <div class="hero-links">
        <a href={`mailto:${site.email}`}>
          Email <span>→</span>
        </a>

        <a
          href={site.github}
          target="_blank"
          rel="noreferrer"
        >
          GitHub <span>↗</span>
        </a>

        <a
          href={site.scholar}
          target="_blank"
          rel="noreferrer"
        >
          Google Scholar <span>↗</span>
        </a>

        <a
          href={withBase(site.cvUrl)}
          target="_blank"
          rel="noreferrer"
        >
          CV <span>↗</span>
        </a>
      </div>

      <div class="about-section compact-about-section">
        <h2>Education</h2>

        <div class="fact-row">
          <div>
            <strong>DePauw University</strong>
            <p>
              B.A. Computer Science · Minors in Psychology and Mathematics
            </p>
          </div>

          <span>2023-2027</span>
        </div>
      </div>
    </div>
  </section>

  <section class="updates-section">
    <h2 class="updates-title">Updates</h2>

    <div class="updates-list">
      {visibleUpdates.map((update) => (
        <article class="update-item">
          <time class="update-date">
            {update.date}
          </time>

          <div class="update-copy">
            <p>
              {update.parts.map((part) => part.href ? <a href={part.href}>{part.text}</a> : part.text)}

              {update.linkLabel && update.linkHref && (
                <>
                  {" "}
                  <a href={update.linkHref}>
                    {update.linkLabel}
                  </a>.
                </>
              )}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>